#. Translators: %(admin)s/%(user)s are usernames, substituted after translation --
#. keep them verbatim.
#, python-format
msgctxt "workflango"
msgid "impersonated by %(admin)s"
msgstr "impersonato da %(admin)s"

#, python-format
msgctxt "workflango"
msgid "%(user)s (impersonated by %(admin)s)"
msgstr "%(user)s (impersonato da %(admin)s)"

msgctxt "workflango"
msgid "Access denied: user is neither the owner nor an administrator."
msgstr "Accesso negato: utente non è proprietario né amministratore."

msgctxt "workflango"
msgid "The object does not have an active state yet."
msgstr "L'oggetto non ha ancora uno stato attivo."

msgctxt "workflango"
msgid "Only the current owner can change the read state."
msgstr "Solo il proprietario corrente può modificare lo stato di lettura."

msgctxt "workflango"
msgid "State"
msgstr "Stato"

#. Translators: %(destination)s is the target phase name, substituted after
#. translation -- keep it verbatim.
#, python-format
msgctxt "workflango"
msgid "Send back to %(destination)s"
msgstr "Rimanda a %(destination)s"

#, python-format
msgctxt "workflango"
msgid "Go to: %(destination)s"
msgstr "Vai a: %(destination)s"

#. Translators: %(destination)s/%(phase)s/%(error)s tokens are placeholders
#. substituted after translation -- keep them verbatim.
#, python-format
msgctxt "workflango"
msgid "The transition to %(destination)s failed: %(error)s."
msgstr "Il passaggio a %(destination)s non è stato effettuato: %(error)s."

#, python-format
msgctxt "workflango"
msgid "Transition to state completed: %(phase)s"
msgstr "Passaggio di stato effettuato: %(phase)s"

#, python-format
msgctxt "workflango"
msgid ""
"The transition will be performed as ADMIN; the following errors were "
"detected: %(error)s."
msgstr ""
"Il passaggio di stato verrà effettuato come ADMIN, sono stati rilevati i "
"seguenti errori: %(error)s."

#, python-format
msgctxt "workflango"
msgid "Cannot perform the transition: %(error)s."
msgstr "Impossibile effettuare il passaggio di stato: %(error)s."

#, python-format
msgctxt "workflango"
msgid "Unexpected error: %(error)s."
msgstr "Errore inatteso: %(error)s."

msgctxt "workflango"
msgid "You do not have access to this resource."
msgstr "L'utente non può accedere a questa risorsa."

msgctxt "workflango"
msgid "Access error: you do not have creation privileges."
msgstr "Errore di accesso: non hai i privilegi di creazione."

msgctxt "workflango"
msgid "The record is suspended. Cannot proceed."
msgstr "Il record è sospeso. Impossibile procedere."

msgctxt "workflango"
msgid "You cannot view this resource."
msgstr "L'utente non può visualizzare questa risorsa."

msgctxt "workflango"
msgid "The object was marked as unread."
msgstr "L'oggetto è stato impostato come da leggere."

msgctxt "workflango"
msgid "The object was marked as read."
msgstr "L'oggetto è stato impostato come già letto."

msgctxt "workflango"
msgid "Take ownership"
msgstr "Prendi in carico"

msgctxt "workflango"
msgid "The object will be taken in charge."
msgstr "L'oggetto verrà preso in carico."

msgctxt "workflango"
msgid "Release"
msgstr "Rilascia"

msgctxt "workflango"
msgid ""
"The object will be released and become available again for take ownership."
msgstr ""
"L'oggetto verrà rilasciato e tornerà disponibile per la presa in carico."

msgctxt "workflango"
msgid "Reject to previous state"
msgstr "Respingi a stato precedente"

msgctxt "workflango"
msgid ""
"The object will be rejected to the phase and user that previously assigned "
"it to you."
msgstr ""
"L'oggetto verrà respinto alla fase e all'utente precedente che te l'ha "
"assegnato."

msgctxt "workflango"
msgid "Reject"
msgstr "Respingi"

msgctxt "workflango"
msgid "Delegate"
msgstr "Delega"

msgctxt "workflango"
msgid "The object will be delegated to the selected user."
msgstr "L'oggetto verrà delegato all'utente selezionato."

msgctxt "workflango"
msgid "Assign"
msgstr "Assegna"

msgctxt "workflango"
msgid "The object will be assigned to the selected user."
msgstr "L'oggetto verrà assegnato all'utente selezionato."

msgctxt "workflango"
msgid "Suspend"
msgstr "Sospendi"

msgctxt "workflango"
msgid "The object will be suspended."
msgstr "L'oggetto verrà sospeso."

msgctxt "workflango"
msgid "Resume"
msgstr "Riprendi"

msgctxt "workflango"
msgid "The object will be resumed."
msgstr "L'oggetto verrà ripreso."

